{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Proportional symbol map: each university at its main campus. Circle area = students enrolled at the selected course level (2024). Colour = 2025 overall-experience rating relative to the national university benchmark. Drag the map to move around. Choose a state to zoom to it (keeping its neighbours in view), and use the zoom slider to look closer; as you zoom in, the view moves toward the state's capital, where most universities are.",
  "width": "container",
  "height": 540,
  "autosize": {
    "type": "fit-x",
    "contains": "padding"
  },
  "params": [
    {
      "name": "level",
      "value": "Undergraduate",
      "bind": {
        "input": "radio",
        "options": [
          "Undergraduate",
          "Postgraduate coursework"
        ],
        "labels": [
          "Undergraduates",
          "Postgraduates (coursework)"
        ],
        "name": "Students: "
      }
    },
    {
      "name": "focus",
      "value": "Australia",
      "bind": {
        "input": "select",
        "options": [
          "Australia",
          "New South Wales",
          "Victoria",
          "Queensland",
          "Western Australia",
          "South Australia",
          "Tasmania",
          "Northern Territory",
          "Australian Capital Territory"
        ],
        "labels": [
          "All of Australia",
          "New South Wales",
          "Victoria",
          "Queensland",
          "Western Australia",
          "South Australia",
          "Tasmania",
          "Northern Territory",
          "Australian Capital Territory"
        ],
        "name": "Zoom to: "
      }
    },
    {
      "name": "zoom",
      "value": 1,
      "bind": {
        "input": "range",
        "min": 1,
        "max": 20,
        "step": 1,
        "name": "Zoom: "
      }
    },
    {
      "name": "panLon",
      "value": 0
    },
    {
      "name": "panLat",
      "value": 0
    },
    {
      "name": "benchmark",
      "expr": "level == 'Undergraduate' ? 76.2 : 77.1"
    },
    {
      "name": "region",
      "expr": "{'Australia': [134.0, -27.5, 0, 0, 134.0, -27.5], 'New South Wales': [147.32, -32.83, 1181, 1035, 151.21, -33.87], 'Victoria': [145.47, -36.57, 805, 570, 144.96, -37.81], 'Queensland': [145.77, -19.21, 1635, 2204, 153.03, -27.47], 'Western Australia': [120.96, -24.43, 1630, 2368, 115.86, -31.95], 'South Australia': [135.0, -32.04, 1132, 1335, 138.6, -34.93], 'Tasmania': [146.16, -41.61, 387, 450, 147.33, -42.88], 'Northern Territory': [133.5, -18.48, 950, 1662, 130.85, -12.46], 'Australian Capital Territory': [149.09, -35.53, 58, 86, 149.13, -35.28]}[focus]"
    },
    {
      "name": "isState",
      "expr": "focus != 'Australia'"
    },
    {
      "name": "ausScale",
      "expr": "min(width * 0.95 / 0.62, height * 0.95 / 0.60)"
    },
    {
      "name": "stateScale",
      "expr": "max(ausScale * 1.3, min(width * 0.65 / (max(region[2], 700) / 6371), height * 0.65 / (max(region[3], 700) / 6371)))"
    },
    {
      "name": "mapScale",
      "expr": "(isState ? stateScale : ausScale) * zoom"
    },
    {
      "name": "towardCapital",
      "expr": "isState ? min(1, (zoom - 1) / 4) : 0"
    },
    {
      "name": "centreLon",
      "expr": "clamp(region[0] + (region[4] - region[0]) * towardCapital + panLon, 108, 158)"
    },
    {
      "name": "centreLat",
      "expr": "clamp(region[1] + (region[5] - region[1]) * towardCapital + panLat, -46, -8)"
    },
    {
      "name": "visibleKm",
      "expr": "width / mapScale * 6371"
    },
    {
      "name": "showNames",
      "expr": "visibleKm < 1300"
    },
    {
      "name": "visibleKmTall",
      "expr": "height / mapScale * 6371"
    }
  ],
  "projection": {
    "type": "conicEqualArea",
    "parallels": [
      -18,
      -36
    ],
    "rotate": {
      "expr": "[-centreLon, 0]"
    },
    "center": {
      "expr": "[0, centreLat]"
    },
    "scale": {
      "expr": "mapScale"
    },
    "translate": {
      "expr": "[width / 2, height / 2]"
    }
  },
  "layer": [
    {
      "data": {
        "url": "data/geo/au_states_detailed.topojson",
        "format": {
          "type": "topojson",
          "feature": "states"
        }
      },
      "mark": {
        "type": "geoshape",
        "fill": "#f0eee8",
        "clip": true
      },
      "encoding": {
        "stroke": {
          "condition": {
            "test": "datum.properties.name == focus",
            "value": "#52514e"
          },
          "value": "#ffffff"
        },
        "strokeWidth": {
          "condition": {
            "test": "datum.properties.name == focus",
            "value": 1.8
          },
          "value": 1.2
        }
      }
    },
    {
      "data": {
        "url": "data/university_scores.csv",
        "format": {
          "type": "csv",
          "parse": {
            "positive_pct": "number",
            "ci_low": "number",
            "ci_high": "number",
            "year": "number"
          }
        }
      },
      "transform": [
        {
          "filter": "datum.year == 2025 && datum.metric == 'overall' && datum.level == level"
        },
        {
          "lookup": "institution",
          "from": {
            "data": {
              "url": "data/geo/university_locations.csv"
            },
            "key": "institution",
            "fields": [
              "enrolment_name",
              "short_name",
              "campus",
              "state",
              "longitude",
              "latitude",
              "location_note"
            ]
          }
        },
        {
          "lookup": "enrolment_name",
          "from": {
            "data": {
              "url": "data/institution_enrolments.csv"
            },
            "key": "institution",
            "fields": [
              "bachelor",
              "postgraduate_coursework"
            ]
          }
        },
        {
          "calculate": "level == 'Undergraduate' ? datum.bachelor : datum.postgraduate_coursework",
          "as": "students"
        },
        {
          "calculate": "datum.positive_pct - benchmark",
          "as": "gap"
        },
        {
          "calculate": "isValid(datum.ci_low) ? format(datum.ci_low, '.1f') + '–' + format(datum.ci_high, '.1f') + '%' : 'not published'",
          "as": "likely_range"
        },
        {
          "calculate": "(datum.gap >= 0 ? '+' : '') + format(datum.gap, '.1f') + ' points vs national (' + format(benchmark, '.1f') + '%)'",
          "as": "gap_label"
        },
        {
          "calculate": "isValid(datum.students) ? format(datum.students, ',') : 'not published'",
          "as": "students_label"
        },
        {
          "calculate": "datum.location_note ? datum.location_note : ''",
          "as": "note"
        }
      ],
      "layer": [
        {
          "transform": [
            {
              "filter": "isValid(datum.students)"
            }
          ],
          "mark": {
            "type": "circle",
            "opacity": 0.88,
            "stroke": "#ffffff",
            "strokeWidth": 1,
            "clip": true
          },
          "encoding": {
            "longitude": {
              "field": "longitude",
              "type": "quantitative"
            },
            "latitude": {
              "field": "latitude",
              "type": "quantitative"
            },
            "size": {
              "field": "students",
              "type": "quantitative",
              "scale": {
                "domain": [
                  0,
                  50000
                ],
                "range": [
                  0,
                  1500
                ]
              },
              "legend": {
                "title": "Students enrolled (2024)",
                "values": [
                  5000,
                  20000,
                  40000
                ],
                "symbolFillColor": "#bdbbb3",
                "symbolStrokeColor": "#ffffff",
                "orient": "bottom",
                "direction": "horizontal",
                "labelExpr": "format(datum.value, ',')"
              }
            },
            "color": {
              "field": "gap",
              "type": "quantitative",
              "scale": {
                "domain": [
                  -10,
                  -5,
                  0,
                  5,
                  10
                ],
                "range": [
                  "#b5481c",
                  "#e0906b",
                  "#c9c7bf",
                  "#6da7ec",
                  "#1c5cab"
                ],
                "interpolate": "rgb",
                "clamp": true
              },
              "legend": {
                "title": "Overall experience vs national average (points)",
                "orient": "bottom",
                "direction": "horizontal",
                "gradientLength": 180,
                "values": [
                  -10,
                  -5,
                  0,
                  5,
                  10
                ],
                "type": "gradient",
                "labelExpr": "datum.value > 0 ? '+' + datum.value : datum.value"
              }
            },
            "order": {
              "field": "students",
              "sort": "descending"
            },
            "tooltip": [
              {
                "field": "institution",
                "title": "University"
              },
              {
                "field": "campus",
                "title": "Plotted at"
              },
              {
                "field": "positive_pct",
                "title": "Rated their overall experience positively (%)",
                "format": ".1f"
              },
              {
                "field": "gap_label",
                "title": "Compared with all universities"
              },
              {
                "field": "likely_range",
                "title": "Likely range (survey margin)"
              },
              {
                "field": "students_label",
                "title": "Students at this level (2024)"
              },
              {
                "field": "note",
                "title": "Note"
              }
            ]
          }
        },
        {
          "transform": [
            {
              "filter": "!isValid(datum.students)"
            }
          ],
          "mark": {
            "type": "circle",
            "size": 70,
            "filled": false,
            "strokeWidth": 2,
            "clip": true
          },
          "encoding": {
            "longitude": {
              "field": "longitude",
              "type": "quantitative"
            },
            "latitude": {
              "field": "latitude",
              "type": "quantitative"
            },
            "stroke": {
              "field": "gap",
              "type": "quantitative",
              "scale": {
                "domain": [
                  -10,
                  -5,
                  0,
                  5,
                  10
                ],
                "range": [
                  "#b5481c",
                  "#e0906b",
                  "#c9c7bf",
                  "#6da7ec",
                  "#1c5cab"
                ],
                "interpolate": "rgb",
                "clamp": true
              },
              "legend": null
            },
            "tooltip": [
              {
                "field": "institution",
                "title": "University"
              },
              {
                "field": "campus",
                "title": "Plotted at"
              },
              {
                "field": "positive_pct",
                "title": "Rated their overall experience positively (%)",
                "format": ".1f"
              },
              {
                "field": "gap_label",
                "title": "Compared with all universities"
              },
              {
                "field": "likely_range",
                "title": "Likely range (survey margin)"
              },
              {
                "field": "students_label",
                "title": "Students at this level (2024)"
              },
              {
                "field": "note",
                "title": "Note"
              }
            ]
          }
        },
        {
          "mark": {
            "type": "text",
            "align": "left",
            "dx": 9,
            "dy": -6,
            "fontSize": 11.5,
            "fontWeight": 600,
            "fill": "#2b2a27",
            "stroke": "#ffffff",
            "strokeWidth": 3,
            "strokeOpacity": 0.85,
            "strokeJoin": "round",
            "clip": true
          },
          "encoding": {
            "longitude": {
              "field": "longitude",
              "type": "quantitative"
            },
            "latitude": {
              "field": "latitude",
              "type": "quantitative"
            },
            "text": {
              "field": "short_name"
            },
            "opacity": {
              "condition": {
                "test": "showNames",
                "value": 1
              },
              "value": 0
            }
          },
          "transform": [
            {
              "filter": "abs(datum.longitude - centreLon) * 111.3 * cos(datum.latitude * PI / 180) < visibleKm * 0.46 && abs(datum.latitude - centreLat) * 110.6 < visibleKmTall * 0.46"
            }
          ]
        },
        {
          "mark": {
            "type": "text",
            "align": "left",
            "dx": 9,
            "dy": -6,
            "fontSize": 11.5,
            "fontWeight": 600,
            "fill": "#2b2a27",
            "clip": true
          },
          "encoding": {
            "longitude": {
              "field": "longitude",
              "type": "quantitative"
            },
            "latitude": {
              "field": "latitude",
              "type": "quantitative"
            },
            "text": {
              "field": "short_name"
            },
            "opacity": {
              "condition": {
                "test": "showNames",
                "value": 1
              },
              "value": 0
            }
          },
          "transform": [
            {
              "filter": "abs(datum.longitude - centreLon) * 111.3 * cos(datum.latitude * PI / 180) < visibleKm * 0.46 && abs(datum.latitude - centreLat) * 110.6 < visibleKmTall * 0.46"
            }
          ]
        }
      ]
    }
  ]
}
